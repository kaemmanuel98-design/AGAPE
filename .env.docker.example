# Copier ce fichier vers `.env.docker` (non versionné) pour `docker compose`.
# Les mêmes variables doivent exister en secrets GitHub pour le build CI (NEXT_PUBLIC_*).

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SITE_URL=https://agape.example.com

# Clé service_role Supabase (Dashboard → Settings → API) : **uniquement côté serveur**.
# Nécessaire pour l’upload des photos d’inscription (bucket `avatars`) et l’affichage de `/profile/[id]`.
# Ne jamais exposer cette valeur en `NEXT_PUBLIC_*`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optionnel : tester academy.agape.com / bible.agape.com via /etc/hosts → 127.0.0.1
# AGAPE_SUBDOMAIN_ROUTING=true
# AGAPE_BIBLE_HOST=bible.agape.com
# AGAPE_ACADEMY_HOST=academy.agape.com
