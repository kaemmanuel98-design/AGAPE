# Copier vers .env.local
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon

# URL publique du site (optionnel ; utilisée pour les redirections Auth)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En production Vercel, ex. :
# NEXT_PUBLIC_SITE_URL=https://votre-fork-agape.vercel.app

# Alertes critiques AGAPE (Resend)
# RESEND_API_KEY=re_xxx
# AGAPE_ALERT_FROM=AGAPE <alerts@votre-domaine.com>
# AGAPE_ALERT_EMAILS=admin1@votre-domaine.com,admin2@votre-domaine.com
# AGAPE_ALERT_API_SECRET=un_secret_long_pour_l_api_interne

# Supabase → Authentication → URL Configuration :
# ajouter les redirections autorisées, ex. :
#   http://localhost:3000/auth/callback
#   https://votre-domaine.com/auth/callback
#   https://votre-fork-agape.vercel.app/auth/callback
#
# Pour inscription / connexion mot de passe sans e-mail de confirmation :
# Authentication → Providers → Email → désactiver « Confirm email »
# (sinon signUp ne renvoie pas de session tant que l’e-mail n’est pas confirmé).
#
# Rôle super-admin automatique pour un e-mail précis : exécuter supabase/migrations/005_profile_role_by_email.sql
# (remplace la fonction handle_new_user ; trigger déjà créé par 003/004).

# Après exécution de supabase/migrations/001_resources_profiles.sql :
# 1) Créer un utilisateur (Auth) puis mettre role = 'super-admin' sur public.profiles
# 2) Créer le bucket Storage "teaching-pdfs" (public) si le script ne l'a pas fait
