# =============================================================================
# Copier ce fichier vers `.env.local` à la racine du projet, puis renseigner les valeurs.
# Supabase → Settings → API : Project URL, anon public, service_role (secret).
# =============================================================================

# --- Obligatoire (client + serveur) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# --- Obligatoire (serveur uniquement — inscription /rejoindre, bucket avatars, /profile/[id]) ---
# Ne jamais préfixer par NEXT_PUBLIC_ ni commiter la vraie clé.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# --- Recommandé (redirections, liens absolus, alertes) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optionnel : alertes critiques (Resend) ---
# RESEND_API_KEY=re_xxx
# AGAPE_ALERT_FROM=AGAPE <alerts@votre-domaine.com>
# AGAPE_ALERT_EMAILS=admin1@votre-domaine.com,admin2@votre-domaine.com
# AGAPE_ALERT_API_SECRET=un_secret_long_pour_l_api_interne

# --- Optionnel : sous-domaines (prod, docker) ---
# AGAPE_SUBDOMAIN_ROUTING=true
# AGAPE_BIBLE_HOST=bible.agape.com
# AGAPE_ACADEMY_HOST=academy.agape.com

# Supabase → Authentication → URL Configuration → Redirect URLs :
#   http://localhost:3000/auth/callback
#   https://votre-domaine.com/auth/callback
#
# Inscription sans e-mail de confirmation : Authentication → Email → désactiver « Confirm email »
#
# Trigger profil : migrations 003/004 + 027 ; metadata signUp : full_name, avatar_url, current_need, city
# Bucket Storage public : avatars (voir migrations 020)
